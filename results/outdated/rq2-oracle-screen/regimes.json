{
  "_comment": "rq2-oracle-screen phase 1. Every regime: randomized generator, random warm-up, 5400 s agent window, layout D, 7 AGVs unless overridden. 'args' are extra switch_oracle.py arguments. --agvs changes the floor only (jobs stay calibrated for 7 AGVs), which is how to make a floor transport-bound.",
  "base-w":        {"what": "training distribution (reference)", "args": []},
  "agv3":          {"what": "3 AGVs on the same jobs (transport-bound)", "args": ["--agvs", "3"]},
  "agv4":          {"what": "4 AGVs", "args": ["--agvs", "4"]},
  "agv5":          {"what": "5 AGVs", "args": ["--agvs", "5"]},
  "agv10":         {"what": "10 AGVs (slack transport)", "args": ["--agvs", "10"]},
  "amax1":         {"what": "arrival cap at full AGV capacity (agv_max_utilization 1.0)", "args": ["--params", "{\"agv_max_utilization\": 1.0}"]},
  "util-hi":       {"what": "heavier load: utilization 1.0-1.8, lulls 0.4-0.7", "args": ["--params", "{\"utilization\": [1.0, 1.8], \"lull_utilization\": [0.4, 0.7]}"]},
  "util-lo":       {"what": "lighter load: utilization 0.5-1.0", "args": ["--params", "{\"utilization\": [0.5, 1.0]}"]},
  "ops-short":     {"what": "short ops 90-180 s (transport share up)", "args": ["--params", "{\"op_mean_seconds\": [90.0, 180.0]}"]},
  "ops-long":      {"what": "long ops 600-1200 s", "args": ["--params", "{\"op_mean_seconds\": [600.0, 1200.0]}"]},
  "route-long":    {"what": "3-8 ops per job", "args": ["--params", "{\"ops_per_job\": [3, 8]}"]},
  "op-var":        {"what": "high op-length variance (op_sigma 0.8)", "args": ["--params", "{\"op_sigma\": 0.8}"]},
  "aff-hi":        {"what": "strong machine affinity (op_machine_spread 0.6)", "args": ["--params", "{\"op_machine_spread\": 0.6}"]},
  "aff-0":         {"what": "no machine affinity (identical machines per type)", "args": ["--params", "{\"op_machine_spread\": 0.0}"]},
  "skew":          {"what": "stronger type skew (skew_weight 5)", "args": ["--params", "{\"skew_weight\": 5.0}"]},
  "flex-p3-m1":    {"what": "flexibility p 0.3, m 1.0", "args": ["--params", "{\"machine_flexibility\": 0.3, \"secondary_time_multiplier\": 1.0}"]},
  "flex-p3-m125":  {"what": "flexibility p 0.3, m 1.25", "args": ["--params", "{\"machine_flexibility\": 0.3, \"secondary_time_multiplier\": 1.25}"]},
  "flex-p5-m125":  {"what": "flexibility p 0.5, m 1.25", "args": ["--params", "{\"machine_flexibility\": 0.5, \"secondary_time_multiplier\": 1.25}"]},
  "mf-off":        {"what": "machine failures off", "args": ["--params", "{\"failure_probability\": 0.0}"]},
  "mf-heavy":      {"what": "machine failures always on, scale 2400 s", "args": ["--params", "{\"failure_probability\": 1.0, \"failures\": {\"machineFailuresEnabled\": true, \"weibullK\": 1.5, \"weibullLambda\": 2400.0, \"repairLogMu\": 6.3, \"repairLogSigma\": 0.5}}"]},
  "agvf1500":      {"what": "AGV breakdowns at scale 1500 operating-s (~11 per episode)", "args": ["--agv-failures", "{\"agvWeibullLambda\": 1500}"]},
  "lay-J":         {"what": "layout J (two-way rows)", "args": ["--layout", "J"]}
}
